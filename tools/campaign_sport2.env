# SPRINT S2 campaign env (2026-08-21) — copy over tools/campaign.env at launch
# (pod.sh sources tools/campaign.env literally; r1c's env is archived in git).
# ONE spot v6e-8 pod; campaigns SEQUENTIAL (sport2 -> d96 -> convert).
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-west1-c"   # spot v6e-8 doors, US-only (PI); first = home
ACCEL=v6e-8
R_TAG=sport2
R_D=16
R_STEPS=20000
ARMS="S0 S1 S2 S3 S4 S5 S6 S7"     # wave 1 = the series as an ablation ladder (8 chips = 8 arms in parallel)
CHAIN_SCRIPT=tools/chain_sport2.sh  # ignores the VH RG RB RT args pod.sh appends
CHAIN_EXTRA_ENV="SX_NPZ=sudoku_extreme_seed0.npz SX_AUG=100 SX_T_STRAT='6 64 256' SX_T_FULL='6 64' SX_K_INIT=16 SX_STRAT=512"
WALL=30600            # remote `timeout` ceiling per launch (s) — 8.5h
SENTINEL=CHAIN-SPORT2-COMPLETE
GCS=gs://qhrrn2-rescue/sport2
FINAL_OBJ=sport2_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
