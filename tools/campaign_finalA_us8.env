# TWO-POD mode (PI 2026-09-06 06:55Z): pod A = a v6e-8 in us-east1-d running A7 (seed of A3), then A3's remaining rows, then A5's battery.
# Shares the finalA bucket and live prefix with pod B (asia-south1-c); markers make the two chains cooperate; both await all arms.
POD=qhrrn2-pod2
ZONES="us-east1-d"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
CHAIN_EXTRA_ENV="C1_MON=2000 SELF_TEARDOWN=1 C1_WAIT_PASSES=600 FINAL_ARMS_1X8='A7 A3 A5 A1' FINAL_NEED_EXTRA='A7 A8'"
BIG_MAX_STRIKES=2
R_TAG=finalA
R_D=384
R_STEPS=50000
ARMS="A0 A1 A2 A3 A4 A5 A6 A7 A8"
CHAIN_SCRIPT=tools/chain_final.sh
WALL=30600
SENTINEL=CHAIN-FINALA-COMPLETE
GCS=gs://qhrrn2-rescue/finalA
FINAL_OBJ=finalA_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl

