# FULL-SET ROWS env (2026-09-12; the PI's go: "run the full eval for C2 D64 ... follow it up with the C5 recommendations"):
# ONE spot v6e-8 in Mumbai; the chain = tools/chain_fullset.sh (the champ filler's d64full_C2, then d128sub_C5 + d256sub_C5;
# idempotent by the filler's GCS markers under gs://qhrrn2-rescue/champ/filler; the partials live-banked under
# gs://qhrrn2-rescue/champ_fullset/live). Walls: ~8.6 h + ~2.8 h + bring-up; cap launch + 18 h. The supervisor tears the
# node down on the sentinel / the final object. Previous env: tools/campaign_decarc_pilot.env (the pilot).
POD=qhrrn2-pod2
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=384
R_STEPS=30000
ARMS="C2 C5"
CHAIN_SCRIPT=tools/chain_fullset.sh
CHAIN_EXTRA_ENV="GCS=gs://qhrrn2-rescue/champ"
SELF_TEARDOWN=0
WALL=50400
SENTINEL=CHAIN-FULLSET-COMPLETE
GCS=gs://qhrrn2-rescue/champ
FINAL_OBJ=fullset_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
