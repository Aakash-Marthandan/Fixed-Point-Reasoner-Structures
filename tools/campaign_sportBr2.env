# PHASE B RUNG 2 campaign env (2026-08-27) — copy over tools/campaign.env at launch.
# d96 full-width (ws6, 2.11M). BOTH shapes supported (PI): v6e-16 hunted first
# (night window; 4 hosts x 4 chips, per-host DP-4 confinement), v6e-8 fallback
# (1x8, all five arms sequential DP-8); 2-strike demotion = availability-based.
POD=qhrrn2-pod2
ZONES="us-east1-d us-east1-c us-east5-b us-central1-a us-central2-b us-west1-c us-west4-a asia-east1-c"
ACCEL=v6e-16
ACCEL_LIST="v6e-16 v6e-8"
BIG_MAX_STRIKES=2
R_TAG=sportBr2
R_D=96
R_STEPS=50000
ARMS="C1 C1s1 C2 C3 C4"
CHAIN_SCRIPT=tools/chain_sportBr2.sh
CHAIN_EXTRA_ENV="ARMS_W0='C1' ARMS_W1='C1s1' ARMS_W2='C2' ARMS_W3='C3 C4' PRIMARY='C1 C1s1 C2 C3' CARRIER_FULLS='C1 C1s1' RD=96 WS=6 SCREEN_K=256 SX_NPZ=sudoku_extreme_seed0.npz SX_AUG=100 SX_T_STRAT='6 64 256' SX_K_INIT=16 SX_STRAT=512 SX_SUB=20000 SX_SUB_K=128 SX_RET_T=8 MON_EVERY=2000 EVAL_BATCH=128 GCS_W1=gs://qhrrn2-rescue/sport2 GCS_R1=gs://qhrrn2-rescue/sportB SELF_TEARDOWN=1"
WALL=30600
SENTINEL=CHAIN-SPORTBR2-COMPLETE
GCS=gs://qhrrn2-rescue/sportBr2
FINAL_OBJ=sportBr2_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
