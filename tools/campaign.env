# PHASE B RUNG 1 campaign env (2026-08-24) — copy over tools/campaign.env at launch.
# ONE spot pod: v6e-16 hunted first (4 hosts x 4 chips; one arm per host, DP-4),
# v6e-8 fallback (all six arms sequential, DP-8); same ladder/strikes as waves 2/3a.
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-west1-c"
ACCEL=v6e-16
ACCEL_LIST="v6e-16"
BIG_MAX_STRIKES=2
R_TAG=sportB
R_D=64
R_STEPS=50000
# d64 FULL-WIDTH (--width-scale 4; n_bulk 959,482) — the wave-3a reference recipes
# scaled in WIDTH ONLY: B1 A2-recipe (RI/NI T12@50k) | B2 A3-recipe (FPA T12@50k) |
# B3 A5-recipe (priced T12@50k) | B4(+s1) S5-recipe (plain T6@20k) | B5 W8-recipe
# (priced T6@20k). PHASE2 = global claim queue (screens vb+mid k256, full tests,
# probes4, PHASE4 winner 20k k128).
ARMS_W0="B1"
ARMS_W1="B2"
ARMS_W2="B3"
ARMS_W3="B4 B4s1 B5"
ARMS="B1 B2 B3 B4 B4s1 B5"
CHAIN_SCRIPT=tools/chain_sportB.sh
CHAIN_EXTRA_ENV="ARMS_W0='B1' ARMS_W1='B2' ARMS_W2='B3' ARMS_W3='B4 B4s1 B5' PRIMARY='B1 B2 B3 B4' RD=64 WS=4 SCREEN_K=256 SX_NPZ=sudoku_extreme_seed0.npz SX_AUG=100 SX_T_STRAT='6 64 256' SX_K_INIT=16 SX_STRAT=512 SX_SUB=20000 SX_SUB_K=128 SX_RET_T=8 MON_EVERY=5000 GCS_W1=gs://qhrrn2-rescue/sport2"
WALL=30600
SENTINEL=CHAIN-SPORTB-COMPLETE
GCS=gs://qhrrn2-rescue/sportB
FINAL_OBJ=sportB_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
