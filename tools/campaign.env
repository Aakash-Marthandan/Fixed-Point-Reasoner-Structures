# tools/campaign.env = tools/campaign_decarc_arc_p0.env at the DEC-ARC night's launch (2026-09-15): the default for every ops tool run
# without POD_ENV. Pod 1 is ALWAYS addressed with POD_ENV=tools/campaign_decarc_arc_p1.env.
# THE DEC-ARC NIGHT — POD 0 OF 2 in the ARC project (2026-09-16; the PI: "Let's launch the runs on the pod then. Carefully set up the
# Google cloud and monitoring environment as this is a shared project ... Yes let's use two v6e-8 pods."). = tools/campaign_decarc_arc.env
# (every science knob identical) + the two-pod split: worker 0 of 2 = D0 then D2 (the RI+FPA seed 0, then the plain twin); its own live prefix (live_w0);
# DA_SHARE_EXIT=1 (a pod whose share ends while the other's runs banks SHARE_DONE_w0 and exits; SHARE_MARK makes its supervisor tear the node
# down; the pod that finds every arm done builds decarc_final.tgz + the sentinel); TPU_RUNTIME=v2-alpha-tpuv6e (the ARC project rejects the
# proven v6e-ubuntu-2404: "The field RuntimeVersion cannot be v6e-ubuntu-2404"; the canary of 2026-09-15 validated this image end to end).
# SHARED lab project, SPOT ONLY: the node is qhrrn2-* and labeled; pod.sh / dispatcher.py refuse anything else; the launchd watchdog lists and
# deletes only qhrrn2-* nodes there. Identity from the git-ignored tools/.gcp_local.env.
# Supervise:  POD_ENV=tools/campaign_decarc_arc_p0.env DRY_SLEEP=480 nohup bash tools/pod.sh supervise 30 > /dev/null 2>&1 &
# Watch:      POD_ENV=tools/campaign_decarc_arc_p0.env bash tools/ops_snapshot.sh   ·   bash tools/ops_watch_pods.sh tools/campaign_decarc_arc_p0.env tools/campaign_decarc_arc_p1.env
source tools/gcp_local.sh || return 2 2>/dev/null || exit 2
export CLOUDSDK_ACTIVE_CONFIG_NAME=$ARC_GCLOUD_CONFIG   # a gcloud configuration pointing at the ARC project (not the active default)
export QHRRN_GCP_PROJECT=$ARC_PROJECT                   # the dispatcher's identity guard
PROJECT=$ARC_PROJECT                                     # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod0
POD_LABELS=program=qhrrn2,owner=aakash,purpose=arc,campaign=decarc,pod=p0
TPU_RUNTIME=v2-alpha-tpuv6e
ZONES="asia-south1-c"   # the PI 2026-09-15 16:20Z: "Let's do the mumbai region for both pods since mumbai is usually stable" (US-first hunting found no v6e-8 spot capacity in us-east1-d, us-east5-b/a, us-central1-a over 16:11–16:19Z)
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=decarc
R_D=160
R_STEPS=30000
ARMS="D0 D1 D2 N0"
CHAIN_SCRIPT=tools/chain_decarc.sh
SELF_TEARDOWN=0
SHARE_MARK=SHARE_DONE_w0
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 C1_WAIT_PASSES=600 RIDER=0 GCS=gs://qhrrn2-arc/decarc GCS_SETS=gs://qhrrn2-arc/sets GCS_CHAMP_SETS=gs://qhrrn2-arc/sets CHAIN_WORKER=0 CHAIN_WORKERS=2 DA_SHARE_EXIT=1 LIVE_PREFIX=gs://qhrrn2-arc/decarc/live_w0 DA_FIT_T=1 DA_FIT_STEPS=150 DA_VIEWS_VH=2 DA_ARC1_VIEWS=1 DA_K_VH=16 DA_ARC1_K=4 DA_COST_BUDGET_H=6 DA_EVAL_START=fieldfix DA_START_ROWS=buffers,symfix,rifix DA_SEL_KEY3=val_pix_ema DA_EXT_PLATEAU_PP=0.02 DA_MON96=1 DA_BRIDGE=1 DA_TRACE_FUSED=1"
WALL=30600
SENTINEL=CHAIN-DECARC-COMPLETE
GCS=gs://qhrrn2-arc/decarc
FINAL_OBJ=decarc_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
