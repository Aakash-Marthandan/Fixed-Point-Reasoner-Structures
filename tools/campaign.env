# THE ONE SOURCE OF TRUTH for the live campaign (2026-08-18 night, PI:
# one stable spot v6e-8 pod finishes the rung — no multi-pod, no queued
# resources, no on-demand). Every launcher / supervisor / manual relaunch
# sources THIS file; nothing else carries these values.
#
# RUNG 1c (ledger 2026-08-20 RUNG-1c LAUNCH REGISTRATION): the WIDTH x BUDGET
# completion — A8 seeds (d48@53k, ->n=3), A10 (d64@40k, the missing 2x2 corner),
# A11/A12 (A5-class 40k anchors = the d96 baseline row), A13 (beta-rescue 6e-5).
# (Rungs 1 and 1b are COMPLETE and ledgered; tags r1, r1b.)
#
# ARM ORDER IS LOAD-BEARING twice over: chain_r0 keys the battery-partial object
# to the FIRST arm (partial_A10s0.tgz), and the DECISIVE 2x2 corners run first
# so a churn day still banks the H-40 verdict early. Keep A10s0 first.
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-west1-c"   # spot v6e-8 doors, US-only (PI); first = home
ACCEL=v6e-8
R_TAG=r1c
R_D=64
R_STEPS=53333
ARMS="A10s0 A8s1 A10s1 A8s2 A11s0 A12s0 A11s1 A12s1 A13s0 A13s1"
CHAIN_SCRIPT=tools/chain_r0.sh   # takes VH RG RB RT (tools/r0_tasks.sh); reads R_TAG/R_D/R_STEPS/R0_ARMS
# extra env (2026-08-20): rt on every arm; e1e3 on exactly the four new 2x2
# corner cells (R0_E13 knob; the A5 anchors and A13 skip e1e3 by design).
CHAIN_EXTRA_ENV="R0_RT_ALL=1 R0_E13='A8s1 A8s2 A10s0 A10s1'"
WALL=30600            # remote `timeout` ceiling per launch (s) — 8.5h
SENTINEL=CHAIN-R0-COMPLETE
GCS=gs://qhrrn2-rescue/rr1c
FINAL_OBJ=r0_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
