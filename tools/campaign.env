# FINAL PHASE Night A env (2026-09-05; Plan_2026-09-05_FinalPhase §3 Night A / §7) — "the class transfer
# and the field ledger": A0 (X0 seed 2, the noise-floor pair) · A1 (X0 + FPA anchor rows) · A2 (X0 + RI) ·
# A3 (DEC-w256, no digit aug: THE arm) · A4 (DEC + digit aug: the redundancy control) · A5 (DEC + FPA + RI).
# Amendment 2: the core DEC arms at w384 (2.78M, our champion's class); the wide arms' battery on labeled subsamples
# (final/alt 50k, D64 100k, scan 5k x k32); the headline D16 full on all 422,786. Night on the 16 ≈ 15 h (A6 the pole);
# the 8-shape fallback is a two-night affair (priority A3 A0 A1 A2 A5 A4; idempotent across relaunches).
# Amendment 3 (PI 2026-09-05: the approved v6e-32 in us-east1-d, weekend US window): eight 4-chip workers, one
# wide arm each — A7 = A3 seed 1 (the DEC's own floor) and A8 = A6 seed 1 (the parity pair) added as optional arms
# (SKIPPED, labeled, on the 16/8 fallbacks). 8x4 map: w0 A3 · w1 A4 · w2 A5 · w3 A6 · w4 A7 · w5 A8 · w6 A0 A1 · w7 A2.
# Night ≈ 15 h (A6/A8 the poles) at ≈ $27.3/h ≈ $410 + weather; cap launch + 18 h.
# A6 (DEC-w512 = X0's parameter class, --remat; the width de-confound) on the 16's fourth worker only.
# US-first zones (standing policy); 16-first (4x4 static map: w0 A3 A0 · w1 A4 A1 · w2 A5 A2 · w3 A6)
# with 8 fallback (1x8 sequential: A3 A4 A5 A0 A1 A2; A6 SKIPPED, labeled). Grids banked at the 2k monitor
# cadence. Every worker preflights its arms (60 full-batch steps each) before any arm runs.
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-central2-b us-west1-c asia-south1-c"   # 18:58Z: Mumbai appended as the last resort after two US preemptions (standing policy: Mumbai only when the US is dry; 16/8 only there)
ACCEL=v6e-16
ACCEL_LIST="v6e-16 v6e-8"   # 18:10Z after the preemption: the 32 dropped for the rest of the night (seed arms pre-skipped; no science gain at 2x the rate)
ACCEL_ZONE_RESTRICT="v6e-32:us-east1-d"   # PI 2026-09-05: the 32 exists in us-east1-d only; any other zone is 16 or 8
BIG_MAX_STRIKES=2
R_TAG=finalA
R_D=384
R_STEPS=50000
ARMS="A0 A1 A2 A3 A4 A5 A6 A7 A8"
CHAIN_SCRIPT=tools/chain_final.sh
CHAIN_EXTRA_ENV="C1_MON=2000 SELF_TEARDOWN=1 C1_WAIT_PASSES=600"   # a worker that finishes early polls up to 20 h for the others (never a false INCOMPLETE on a 15 h night)
WALL=30600
SENTINEL=CHAIN-FINALA-COMPLETE
GCS=gs://qhrrn2-rescue/finalA
FINAL_OBJ=finalA_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
