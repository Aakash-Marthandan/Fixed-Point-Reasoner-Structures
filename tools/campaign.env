# PHASE B RUNG 2B campaign env (2026-08-29) — copy over tools/campaign.env at launch.
# d96 follow-up round: D1 (T6 FPA @50k, winner extended) · D2 (C3-recipe seed 1,
# noise pair) · D3 (T12 FPA @50k lr5e-4 + bnl 1e-6 — H-48 primary) · D4 (T12 FPA
# @50k lr1e-3 + bnl 1e-6 — registered-lr restoration). ONE-SHOT arms (NaN ->
# in-chain amputation, no retries). BOTH shapes (16 = 4x4 / 8 = 1x8 fallback).
# ZONES Mumbai-first (PI 2026-08-29: "launch on the mumbai pod that's been
# stable so far" — asia-south1-c = the proven v6e-16 source, ran 27h clean).
# BUDGET CAPS (registration §ops): deadline set at launch to +22h (B2 — the
# watchdog enforces it; extension needs an explicit PI go); projection gate at
# canary (B1); churn circuit-breaker during US-day hours (B3, session layer).
POD=qhrrn2-pod2
ZONES="asia-south1-c asia-south1-b us-east1-d us-east1-c us-east5-b us-central1-a us-central2-b us-west1-c us-west4-a asia-east1-c"
ACCEL=v6e-16
ACCEL_LIST="v6e-16 v6e-8"
BIG_MAX_STRIKES=2
R_TAG=sportBr2b
R_D=96
R_STEPS=50000
ARMS="D1 D2 D3 D4"
CHAIN_SCRIPT=tools/chain_sportBr2b.sh
CHAIN_EXTRA_ENV="ARMS_W0='D3' ARMS_W1='D4' ARMS_W2='D1 C3X' ARMS_W3='D2' PRIMARY='D1 D3' RD=96 WS=6 SCREEN_K=256 SX_NPZ=sudoku_extreme_seed0.npz SX_AUG=100 SX_T_STRAT='6 64 256' SX_K_INIT=16 SX_STRAT=512 SX_SUB=20000 SX_SUB_K=128 SX_RET_T=8 MON_EVERY=2000 EVAL_BATCH=128 CLAIM_TTL=14400 D96_C3_VB=0.8848 GCS_W1=gs://qhrrn2-rescue/sport2 SELF_TEARDOWN=1"
WALL=30600
SENTINEL=CHAIN-SPORTBR2B-COMPLETE
GCS=gs://qhrrn2-rescue/sportBr2b
FINAL_OBJ=sportBr2b_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
