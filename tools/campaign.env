# sportC2 env (2026-09-04; Plan_2026-09-04_sportC2 §2/§6) — the pre-parity graft
# night at d128: W0 (B0 + wd 1.0, the base) · R1 (+ persistent carry) · R2 (+ inner
# cycles K3) · R3 (+ hard rows) · R4 (sportC1 R0 +50k, field regime) · X1 (X0 -
# digit aug) · X2 (X0 + our group mixer) + riders, one night. US-first zones
# (standing policy); 16-first (4x4 static map: w0 W0 R2 · w1 R1 R3 · w2 R4 X1 ·
# w3 X2 + riders) with 8 fallback (1x8 sequential, priority order in the chain).
POD=qhrrn2-pod2
ZONES="asia-south1-c asia-south1-b"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=2
R_TAG=sportC2
R_D=128
R_STEPS=80000
ARMS="W0 R1 R2 R3 R4 X1 X2"
CHAIN_SCRIPT=tools/chain_sportC2.sh
CHAIN_EXTRA_ENV="C1_MON=2000 SELF_TEARDOWN=1"
WALL=30600
SENTINEL=CHAIN-SPORTC2-COMPLETE
GCS=gs://qhrrn2-rescue/sportC2
FINAL_OBJ=sportC2_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
