# THE WIDTH LADDER — pod 1 of two, in the ARC project, a FRESH prefix (2026-09-18; Documentation/Plan_2026-09-18_Width_Ladder.md = the registration).
# Arms [SA256 SA192]: the symmetric DEC at seed 0, fixed 30,000 steps, the reduced battery on the identical 5,000 test puzzles (tools/chain_wladder.sh).
# READ-ONLY sources under gs://qhrrn2-arc/rescue/champ: sets/, jax_cache.tgz. Everything written lives under gs://qhrrn2-arc/rescue/wladder_p1.
# SHARED lab project, SPOT ONLY: the node is qhrrn2-* and labeled; identity from the git-ignored tools/.gcp_local.env.
# Supervise:  POD_ENV=tools/campaign_wladder_p1.env DRY_SLEEP=480 nohup bash tools/pod.sh supervise 30 > /dev/null 2>&1 &
# Watch:      HB_TICKS=1 HB_EVERY=900 HB_FIRST_SLEEP=900 bash tools/ops_watch_pods.sh tools/campaign_wladder_p0.env tools/campaign_wladder_p1.env
source tools/gcp_local.sh || return 2 2>/dev/null || exit 2
export CLOUDSDK_ACTIVE_CONFIG_NAME=$ARC_GCLOUD_CONFIG   # a gcloud configuration pointing at the ARC project (not the active default)
export QHRRN_GCP_PROJECT=$ARC_PROJECT                   # the dispatcher's identity guard
PROJECT=$ARC_PROJECT                                     # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod1
POD_LABELS=program=qhrrn2,owner=aakash,purpose=sudoku-paper1,campaign=wladder,pod=p1
TPU_RUNTIME=v2-alpha-tpuv6e
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=192
R_STEPS=30000
ARMS="SA256 SA192"
CHAIN_SCRIPT=tools/chain_wladder.sh
SELF_TEARDOWN=0
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 WL_ARMS='SA256 SA192' GCS=gs://qhrrn2-arc/rescue/wladder_p1 GCS_SETS=gs://qhrrn2-arc/rescue/champ/sets LIVE_PREFIX=gs://qhrrn2-arc/rescue/wladder_p1/live WL_SRC=gs://qhrrn2-arc/rescue/champ"
WALL=30600
SENTINEL=CHAIN-WLADDER-COMPLETE
GCS=gs://qhrrn2-arc/rescue/wladder_p1
FINAL_OBJ=wladder_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
