# THE ATTENTION ARMS TO THE PAPER'S BUDGET — pod 0, arm SA128 (SE-RRM's two mixers inside our block, loop and recipe at hidden 128) RESUMED from its banked
# 30k state to 50,000 steps, then the full champion battery + the four filler rows (2026-09-19; Documentation/Plan_2026-09-19_SA_Extension.md = the registration;
# the PI: "extend SA128 / SA192 / SA256 from 30k to 50k, then the full champion battery"). The banked state is READ from gs://qhrrn2-arc/rescue/wladder_p0 (never
# written); everything written lives under gs://qhrrn2-arc/rescue/saext_p0. ONE spot v6e-8, Mumbai. SE_JOBS=none would run the champion battery alone (option A).
# SHARED lab project, SPOT ONLY: the node is qhrrn2-* and labeled; pod.sh / dispatcher.py refuse anything else. Identity from the git-ignored tools/.gcp_local.env.
# Supervise:  POD_ENV=tools/campaign_saext_p0.env DRY_SLEEP=480 nohup bash tools/pod.sh supervise 30 > /dev/null 2>&1 &
# Watch:      HB_TICKS=1 HB_EVERY=900 HB_FIRST_SLEEP=900 bash tools/ops_watch_pods.sh tools/campaign_saext_p0.env tools/campaign_saext_p1.env tools/campaign_saext_p2.env
source tools/gcp_local.sh || return 2 2>/dev/null || exit 2
export CLOUDSDK_ACTIVE_CONFIG_NAME=$ARC_GCLOUD_CONFIG   # a gcloud configuration pointing at the ARC project (not the active default)
export QHRRN_GCP_PROJECT=$ARC_PROJECT                   # the dispatcher's identity guard
PROJECT=$ARC_PROJECT                                     # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod0
POD_LABELS=program=qhrrn2,owner=aakash,purpose=sudoku-paper1,campaign=saext,pod=p0
TPU_RUNTIME=v2-alpha-tpuv6e
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=128
R_STEPS=50000
ARMS="SA128"
CHAIN_SCRIPT=tools/chain_saext.sh
SELF_TEARDOWN=0
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 SE_ARM=SA128 SE_SRC=gs://qhrrn2-arc/rescue/wladder_p0 SE_JOBS=d64full,d128sub,d256sub,k128 GCS=gs://qhrrn2-arc/rescue/saext_p0 GCS_SETS=gs://qhrrn2-arc/rescue/champ/sets LIVE_PREFIX=gs://qhrrn2-arc/rescue/saext_p0/live"
WALL=30600
SENTINEL=CHAIN-SAEXT-COMPLETE
GCS=gs://qhrrn2-arc/rescue/saext_p0
FINAL_OBJ=saext_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
