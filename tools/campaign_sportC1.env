# CHAMPION sportC1 env (2026-09-02; Plan_2026-09-02_Champion_sportC1 §12) — the
# d128 round: A0 A1 (controls) · B0 B1 (+ z-norm bridge) · R0 (field optimizer
# regime) · X0 (field baseline, TRM/EqR cell + SOT + ACT) · X0n (rider), one
# night. US-first zones (standing policy); 16-first (4x4 static map: w0 A0 B0 ·
# w1 A1 B1 · w2 R0 · w3 X0 X0n + canvas riders) with 8 fallback (1x8 sequential).
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-central2-b us-west1-c"
ACCEL=v6e-16
ACCEL_LIST="v6e-16 v6e-8"
BIG_MAX_STRIKES=2
R_TAG=sportC1
R_D=128
R_STEPS=80000
ARMS="A0 A1 B0 B1 R0 X0 X0n"
CHAIN_SCRIPT=tools/chain_sportC1.sh
CHAIN_EXTRA_ENV="C1_MON=2000 SELF_TEARDOWN=1"
WALL=30600
SENTINEL=CHAIN-SPORTC1-COMPLETE
GCS=gs://qhrrn2-rescue/sportC1
FINAL_OBJ=sportC1_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
