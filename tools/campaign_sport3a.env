# SPRINT S2 WAVE 3a campaign env (2026-08-23) — copy over tools/campaign.env at launch.
# ONE spot pod: v6e-16 hunted first (4 hosts x 4 chips), v6e-8 fallback; same ladder/strikes as wave 2.
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-west1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-16 v6e-8"
BIG_MAX_STRIKES=2
R_TAG=sport3a
R_D=16
R_STEPS=50000
# 8 training arms; on a v6e-16 they split 4 ways (one per chip); on a v6e-8 all eight run one per chip.
# PHASE0 breadth scans (S5, sharded over the worker's chips) run on worker 0 before its arms.
# v6e-16 addendum (2026-08-23 18:45 IST, PI: use the 16 efficiently): +8 arms on the idle chips —
# seed replicates of each candidate recipe + the two combinations (A9 RI/NI+FPA, A10 priced+RI/NI).
ARMS_W0="A2 A3 A2s1 A3s1"
ARMS_W1="A4 A5 A4s1 A5s1"
ARMS_W2="A6 A7 A9 A9s1"
ARMS_W3="A7s1 A8 A10 A6s1"
ARMS="A2 A3 A2s1 A3s1 A4 A5 A4s1 A5s1 A6 A7 A9 A9s1 A7s1 A8 A10 A6s1"
CHAIN_SCRIPT=tools/chain_sport3a.sh
CHAIN_EXTRA_ENV="ARMS_W0='A2 A3 A2s1 A3s1' ARMS_W1='A4 A5 A4s1 A5s1' ARMS_W2='A6 A7 A9 A9s1' ARMS_W3='A7s1 A8 A10 A6s1' BSCANS='bscan:S5:20000:128 bscan:S5:20000:256 bscan:S5:strat:1024' SX_NPZ=sudoku_extreme_seed0.npz SX_AUG=100 SX_T_STRAT='6 64 256' SX_T_FULL='6 64' SX_K_INIT=16 SX_STRAT=512 SX_SUB=20000 SX_SUB_K=128 SX_RET_T=8 MON_EVERY=5000 GCS_W1=gs://qhrrn2-rescue/sport2 W1_TAG=sport2"
WALL=30600
SENTINEL=CHAIN-SPORT3A-COMPLETE
GCS=gs://qhrrn2-rescue/sport3a
FINAL_OBJ=sport3a_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
