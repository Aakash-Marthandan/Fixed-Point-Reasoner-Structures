# SE-RRM ATTRIBUTION ROUND 1 — one pod, arms SA256B then SA256BR in sequence (2026-10-02; Documentation/Note_2026-10-02_Attribution_Round1_Registration.md
# = the registration). SA256 with SE-RRM's released optimizer (batch 272; lr 1e-4 = ours): SA256B at their budget (36,000 steps), SA256BR at the
# reference's rows (84,000 steps; cadence 5,600). Seed 0, fixed budgets, the reduced battery on the identical 5,000. Cap $120.
# Everything written lives under gs://qhrrn2-arc/rescue/attr1_p0 (fresh); the ladder's and the champion's prefixes are READ ONLY. ONE spot v6e-8, Mumbai.
# SHARED lab project, SPOT ONLY: the node is qhrrn2-* and labeled; pod.sh / dispatcher.py refuse anything else. Identity from the git-ignored tools/.gcp_local.env.
# Supervise:  POD_ENV=tools/campaign_attr1_p0.env DRY_SLEEP=480 nohup bash tools/pod.sh supervise 30 > /dev/null 2>&1 &
# Watch:      HB_TICKS=1 HB_EVERY=900 HB_FIRST_SLEEP=900 bash tools/ops_watch_pods.sh tools/campaign_attr1_p0.env
source tools/gcp_local.sh || return 2 2>/dev/null || exit 2
export CLOUDSDK_ACTIVE_CONFIG_NAME=$ARC_GCLOUD_CONFIG   # a gcloud configuration pointing at the ARC project (not the active default)
export QHRRN_GCP_PROJECT=$ARC_PROJECT                   # the dispatcher's identity guard
PROJECT=$ARC_PROJECT                                     # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod
POD_LABELS=program=qhrrn2,owner=aakash,purpose=sudoku-paper1,campaign=attr1,pod=p0
TPU_RUNTIME=v2-alpha-tpuv6e
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=256
R_STEPS=84000
ARMS="SA256B SA256BR"
CHAIN_SCRIPT=tools/chain_sablate.sh
SELF_TEARDOWN=0
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 AB_ARMS='SA256B SA256BR' GCS=gs://qhrrn2-arc/rescue/attr1_p0 GCS_SETS=gs://qhrrn2-arc/rescue/champ/sets LIVE_PREFIX=gs://qhrrn2-arc/rescue/attr1_p0/live AB_SRC=gs://qhrrn2-arc/rescue/wladder_p1"
WALL=30600
SENTINEL=CHAIN-SABLATE-COMPLETE
GCS=gs://qhrrn2-arc/rescue/attr1_p0
FINAL_OBJ=sablate_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
