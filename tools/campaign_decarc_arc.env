# THE ARC ERA — the DEC-ARC campaign env re-pointed at the ARC project (2026-09-15; the PI: "all further ARC project content and
# compute goes there"). = tools/campaign_decarc.env (the DEC-ARC night, Plan_2026-09-10_DEC-ARC_Build.md) with ONLY the project,
# bucket, node name, labels and zones changed; every science knob is copied unchanged. NOT ACTIVE: launch only on the PI's go
# (spend envelope + a canary first; tools/HANDOFF.md "THE ARC PROJECT"). Activate by copying to tools/campaign.env at launch.
# A SHARED lab project: our nodes are named qhrrn2-* and labeled (the launchd watchdog lists and deletes ONLY qhrrn2-* nodes there);
# no IAM changes; never another member's node or bucket. Identity: the gcloud configuration below holds the account (the public
# repo names no account); the default gcloud configuration stays on the Sudoku-era project.
export CLOUDSDK_ACTIVE_CONFIG_NAME=qhrrn2-arc        # gcloud config: project anita-hunter (created 2026-09-15, not the active default)
export QHRRN_GCP_PROJECT=anita-hunter                # the dispatcher's identity guard (tools/.gcp_identity keeps the Sudoku-era pair)
PROJECT=anita-hunter                                  # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod
POD_LABELS=program=qhrrn2,owner=aakash,purpose=arc
ZONES="us-east1-d us-east5-b us-east5-a us-central1-a us-central1-b us-central1-c us-west1-c us-south1-a asia-south1-c"   # the project's v6e zones, US first, Mumbai last (europe-west4-a also offers v6e; not in the rotation without the PI)
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=decarc
R_D=160
R_STEPS=30000
ARMS="D0 D1 D2 N0"
CHAIN_SCRIPT=tools/chain_decarc.sh
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 C1_WAIT_PASSES=600 RIDER=0 GCS=gs://qhrrn2-arc/decarc GCS_SETS=gs://qhrrn2-arc/sets GCS_CHAMP_SETS=gs://qhrrn2-arc/sets"
WALL=30600
SENTINEL=CHAIN-DECARC-COMPLETE
GCS=gs://qhrrn2-arc/decarc
FINAL_OBJ=decarc_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
