# SPRINT S2 WAVE 2 campaign env (2026-08-22) — copy over tools/campaign.env at launch
# (pod.sh sources tools/campaign.env literally; wave-1's env is tools/campaign_sport2.env).
# ONE spot pod: v6e-16 (2 workers x 8 chips) hunted FIRST, v6e-8 as the fallback (PI 2026-08-22);
# the big accelerator is demoted after BIG_MAX_STRIKES bring-up failures/preemptions.
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-west1-c"   # spot v6e doors, US-only (PI); first = home
ACCEL=v6e-8                              # legacy single value (fallback)
ACCEL_LIST="v6e-16 v6e-8"                # hunt order per pass; last = fallback
BIG_MAX_STRIKES=2
R_TAG=sport2w2
R_D=16                                   # informational: wave-2 arms carry --d/--steps in arm_flags
R_STEPS=20000
# job lists per worker (chain_sport2w2.sh): with 1 worker both lists run on it (round-robin, 2 jobs/chip)
ARMS_W0="W13 W2 W3 W1 W9 W5 W4 W8"
ARMS_W1="scan:S5:64:256 scan:S4:64:256 scan:S7:64:256 scan:S5:6:256 W6 W7 W1s1 W4s1"
ARMS="W13 W2 W3 W1 W9 W5 W4 W8 scan:S5:64:256 scan:S4:64:256 scan:S7:64:256 scan:S5:6:256 W6 W7 W1s1 W4s1"
CHAIN_SCRIPT=tools/chain_sport2w2.sh     # ignores the VH RG RB RT args pod.sh appends
CHAIN_EXTRA_ENV="ARMS_W0='W13 W2 W3 W1 W9 W5 W4 W8' ARMS_W1='scan:S5:64:256 scan:S4:64:256 scan:S7:64:256 scan:S5:6:256 W6 W7 W1s1 W4s1' SX_NPZ=sudoku_extreme_seed0.npz GEN_NPZ=sudoku_gen_g22_seed0.npz SX_AUG=100 SX_T_STRAT='6 64 256' SX_T_FULL='6 64' SX_K_INIT=16 SX_STRAT=512 SX_SUB=20000 SX_SUB_K=128 SX_RET_T=8 GCS_W1=gs://qhrrn2-rescue/sport2 W1_TAG=sport2"
WALL=30600            # remote `timeout` ceiling per launch (s) — 8.5h (the DMS window is 10h; relaunch resumes)
SENTINEL=CHAIN-SPORT2W2-COMPLETE
GCS=gs://qhrrn2-rescue/sport2w2
FINAL_OBJ=sport2w2_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
