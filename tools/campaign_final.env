# FINAL PHASE Night A env (2026-09-05; Plan_2026-09-05_FinalPhase §3 Night A / §7) — "the class transfer
# and the field ledger": A0 (X0 seed 2, the noise-floor pair) · A1 (X0 + FPA anchor rows) · A2 (X0 + RI) ·
# A3 (DEC-w256, no digit aug: THE arm) · A4 (DEC + digit aug: the redundancy control) · A5 (DEC + FPA + RI).
# US-first zones (standing policy); 16-first (4x4 static map: w0 A3 A0 · w1 A4 A1 · w2 A5 A2 · w3 idle)
# with 8 fallback (1x8 sequential: A3 A4 A5 A0 A1 A2). Grids banked at the 2k monitor cadence.
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-central2-b us-west1-c"
ACCEL=v6e-16
ACCEL_LIST="v6e-16 v6e-8"
BIG_MAX_STRIKES=2
R_TAG=finalA
R_D=256
R_STEPS=50000
ARMS="A0 A1 A2 A3 A4 A5"
CHAIN_SCRIPT=tools/chain_final.sh
CHAIN_EXTRA_ENV="C1_MON=2000 SELF_TEARDOWN=1"
WALL=30600
SENTINEL=CHAIN-FINALA-COMPLETE
