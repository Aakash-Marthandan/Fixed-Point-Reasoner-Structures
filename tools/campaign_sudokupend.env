# THE PENDING SUDOKU RUNS FOR PAPER 1 — in the ARC project on the MIRRORED champion prefix (2026-09-17; the PI: "Option 3, S2 + X5, lift the
# freeze, go"). Documentation/Plan_2026-09-17_Sudoku_Pending_Runs.md = the registration. The old project's bucket (gs://qhrrn2-rescue, 93 GB)
# could NOT be mirrored (its billing account is disabled: object data is unreadable, 403), so the champion prefix was REBUILT under
# gs://qhrrn2-arc/rescue/champ from this Mac's crc32c-verified pulls: the corpus (champ/sets), C7's 46k pretrain tarball, the C0-C8
# ARM_OK / PRETRAIN_OK markers (true completions), RECIPE-DEC (BATCHONLY) and SYNC-AB; C8's 46k grid under rescue/c8x. Both paper grids
# resolve through the registered grid override (FILLER_CK_C7 / FILLER_CK_C8); no PREFLIGHT marker, so X5 preflights. ONE spot v6e-8, Mumbai, the ARC project's image.
# SHARED lab project, SPOT ONLY: the node is qhrrn2-* and labeled; pod.sh / dispatcher.py refuse anything else; the launchd watchdog lists and
# deletes only qhrrn2-* nodes there. Identity from the git-ignored tools/.gcp_local.env.
# Supervise:  POD_ENV=tools/campaign_sudokupend.env DRY_SLEEP=480 nohup bash tools/pod.sh supervise 30 > /dev/null 2>&1 &
# Watch:      HB_TICKS=1 HB_EVERY=900 HB_FIRST_SLEEP=900 bash tools/ops_watch_pods.sh tools/campaign_sudokupend.env
source tools/gcp_local.sh || return 2 2>/dev/null || exit 2
export CLOUDSDK_ACTIVE_CONFIG_NAME=$ARC_GCLOUD_CONFIG   # a gcloud configuration pointing at the ARC project (not the active default)
export QHRRN_GCP_PROJECT=$ARC_PROJECT                   # the dispatcher's identity guard
PROJECT=$ARC_PROJECT                                     # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod0
POD_LABELS=program=qhrrn2,owner=aakash,purpose=sudoku-paper1,campaign=sudokupend,pod=p0
TPU_RUNTIME=v2-alpha-tpuv6e
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=160
R_STEPS=50000
ARMS="X5"
CHAIN_SCRIPT=tools/chain_sudokupend.sh
SELF_TEARDOWN=0
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 GCS=gs://qhrrn2-arc/rescue/champ GCS_SETS=gs://qhrrn2-arc/rescue/champ/sets LIVE_PREFIX=gs://qhrrn2-arc/rescue/champ_pend/live SP_ARMS=X5 FILLER_CK_C7=gs://qhrrn2-arc/rescue/champ/C7_pretrain.tgz,runs/pretrainchamp_C7/ckpt_046000.pkl FILLER_CK_C8=gs://qhrrn2-arc/rescue/c8x/C8_pretrain.tgz,runs/pretrainchamp_C8/ckpt_046000.pkl"
WALL=30600
SENTINEL=CHAIN-SUDOKUPEND-COMPLETE
GCS=gs://qhrrn2-arc/rescue/champ
FINAL_OBJ=sudokupend_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
