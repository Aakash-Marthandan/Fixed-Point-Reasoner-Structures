# THE X5 LONG RUN — in the ARC project, a FRESH prefix (2026-09-17; Documentation/Plan_2026-09-17_X5_Long.md = the registration). X5 (TRM's cell
# at hidden 160 under the full recipe, parameter-matched to the width-192 DEC) resumed from its banked 50k state to the COMPUTE-MATCHED budget of
# 960,000 steps (50k x 272.7 / 14.2, the measured same-pod paces), then the champion battery + the k128 row on the monitor-selected grid.
# READ-ONLY sources under gs://qhrrn2-arc/rescue/champ: X5_pretrain.tgz (the 50k state, crc32c 3GaBrA==, not composite), sets/, jax_cache.tgz.
# Everything written lives under gs://qhrrn2-arc/rescue/x5l. ONE spot v6e-8, Mumbai, the ARC project's image.
# SHARED lab project, SPOT ONLY: the node is qhrrn2-* and labeled; pod.sh / dispatcher.py refuse anything else; the launchd watchdog lists and
# deletes only qhrrn2-* nodes there. Identity from the git-ignored tools/.gcp_local.env.
# Supervise:  POD_ENV=tools/campaign_x5long.env DRY_SLEEP=480 nohup bash tools/pod.sh supervise 30 > /dev/null 2>&1 &
# Watch:      HB_TICKS=1 HB_EVERY=900 HB_FIRST_SLEEP=900 bash tools/ops_watch_pods.sh tools/campaign_x5long.env
source tools/gcp_local.sh || return 2 2>/dev/null || exit 2
export CLOUDSDK_ACTIVE_CONFIG_NAME=$ARC_GCLOUD_CONFIG   # a gcloud configuration pointing at the ARC project (not the active default)
export QHRRN_GCP_PROJECT=$ARC_PROJECT                   # the dispatcher's identity guard
PROJECT=$ARC_PROJECT                                     # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod0
POD_LABELS=program=qhrrn2,owner=aakash,purpose=sudoku-paper1,campaign=x5long,pod=p0
TPU_RUNTIME=v2-alpha-tpuv6e
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=160
R_STEPS=960000
ARMS="X5"
CHAIN_SCRIPT=tools/chain_x5long.sh
SELF_TEARDOWN=0
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 GCS=gs://qhrrn2-arc/rescue/x5l GCS_SETS=gs://qhrrn2-arc/rescue/champ/sets LIVE_PREFIX=gs://qhrrn2-arc/rescue/x5l/live X5L_SRC=gs://qhrrn2-arc/rescue/champ X5L_EXT_FROM=50000 X5L_EXT_TO=960000 X5L_MON=10000 X5L_CKPT=5000"
WALL=30600
SENTINEL=CHAIN-X5LONG-COMPLETE
GCS=gs://qhrrn2-arc/rescue/x5l
FINAL_OBJ=x5long_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
