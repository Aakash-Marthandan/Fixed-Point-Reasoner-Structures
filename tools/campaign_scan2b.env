# RUNG 2B RIDER SCANS env (2026-08-30, PI-decided at the verdict) — C3X + D4
# 20k k128 t64 scans, PHASE4-identical flags, static shard map (no claims).
# US-ONLY zones per PI (weekend window; us-east1-d first); 16-first, 8 fallback
# (8 = sequential scans ~11h; 16 = concurrent ~5.6h).
POD=qhrrn2-pod2
ZONES="us-east1-d us-east5-b us-central1-a us-central2-b us-west1-c"
ACCEL=v6e-16
ACCEL_LIST="v6e-16 v6e-8"
BIG_MAX_STRIKES=2
R_TAG=sportBr2b
R_D=96
R_STEPS=50000
ARMS="C3X D4"
CHAIN_SCRIPT=tools/scan_runbook_sportBr2b.sh
CHAIN_EXTRA_ENV="SX_SUB=20000 SX_SUB_K=128 EVAL_BATCH=128 SELF_TEARDOWN=1"
WALL=30600
SENTINEL=SCAN-SPORTBR2B-COMPLETE
GCS=gs://qhrrn2-rescue/sportBr2b
FINAL_OBJ=p4x_COMPLETE.txt
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
