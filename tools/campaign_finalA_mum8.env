# TWO-POD mode (PI 2026-09-06 06:55Z): pod B = a v6e-8 in asia-south1-c running A8 (seed of A6's class... the parity pair), then A2, then A4's remaining rows, then A1's scan.
# Shares the finalA bucket and live prefix with pod A (us-east1-d).
POD=qhrrn2-pod3
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
CHAIN_EXTRA_ENV="C1_MON=2000 SELF_TEARDOWN=1 C1_WAIT_PASSES=600 FINAL_ARMS_1X8='A8 A2 A4' FINAL_NEED_EXTRA='A7 A8'"
BIG_MAX_STRIKES=2
R_TAG=finalA
R_D=384
R_STEPS=50000
ARMS="A0 A1 A2 A3 A4 A5 A6 A7 A8"
CHAIN_SCRIPT=tools/chain_final.sh
WALL=30600
SENTINEL=CHAIN-FINALA-COMPLETE
GCS=gs://qhrrn2-rescue/finalA
FINAL_OBJ=finalA_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl

