# THE WIDTH-192 LONG RUN env (2026-09-14; Documentation/Plan_2026-09-14_W192_Long.md = the registration; the PI: "let's do it, this is worth
# looking into for the ARC DEC port — but use a 50k subsample for evals rather than the full"). ONE spot v6e-8 in Mumbai; the chain =
# tools/chain_c5l.sh (C5 resumed from its banked 50k state to 150k, pretrain-only; the held-out 10k + train-1k instruments at every grid of C5
# and of the width-384/512 runs C1 A5 A7 A8; the test rows on the 50k subsample only). Written only under gs://qhrrn2-rescue/c5l; champ/,
# finalA/ and c8x/ are read-only. Walls ~10-11 h (this cell's measured paces); cap launch + 18 h. SELF_TEARDOWN=0: the supervisor tears the node
# down on the final object / the sentinel.
POD=qhrrn2-pod2
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=192
R_STEPS=150000
ARMS="C5"
CHAIN_SCRIPT=tools/chain_c5l.sh
CHAIN_EXTRA_ENV="GCS=gs://qhrrn2-rescue/c5l LIVE_PREFIX=gs://qhrrn2-rescue/c5l/live"
SELF_TEARDOWN=0
WALL=64800
SENTINEL=CHAIN-C5L-COMPLETE
GCS=gs://qhrrn2-rescue/c5l
FINAL_OBJ=c5l_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
