# THE RECIPE ABLATION — pod 2, arm SA256O = SA256 with the OPTIMIZER (SE-RRM's batch 272 and lr 5e-4) (2026-09-19; Documentation/Plan_2026-09-19_Recipe_Ablation.md = the
# registration; the PI: "Change the three things to locate the advantage we have"). Seed 0, a FIXED 30k, the reduced battery on the identical 5,000.
# Everything written lives under gs://qhrrn2-arc/rescue/sablate_p2; the ladder's and the champion's prefixes are READ ONLY. ONE spot v6e-8, Mumbai.
# SHARED lab project, SPOT ONLY: the node is qhrrn2-* and labeled; pod.sh / dispatcher.py refuse anything else. Identity from the git-ignored tools/.gcp_local.env.
# Supervise:  POD_ENV=tools/campaign_sablate_p2.env DRY_SLEEP=480 nohup bash tools/pod.sh supervise 30 > /dev/null 2>&1 &
# Watch:      HB_TICKS=1 HB_EVERY=900 HB_FIRST_SLEEP=900 bash tools/ops_watch_pods.sh tools/campaign_sablate_p0.env tools/campaign_sablate_p1.env tools/campaign_sablate_p2.env
source tools/gcp_local.sh || return 2 2>/dev/null || exit 2
export CLOUDSDK_ACTIVE_CONFIG_NAME=$ARC_GCLOUD_CONFIG   # a gcloud configuration pointing at the ARC project (not the active default)
export QHRRN_GCP_PROJECT=$ARC_PROJECT                   # the dispatcher's identity guard
PROJECT=$ARC_PROJECT                                     # pod.sh / ops_snapshot.sh / dms_keeper.sh / plant_guard.sh
POD=qhrrn2-arc-pod2
POD_LABELS=program=qhrrn2,owner=aakash,purpose=sudoku-paper1,campaign=sablate,pod=p2
TPU_RUNTIME=v2-alpha-tpuv6e
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=256
R_STEPS=30000
ARMS="SA256O"
CHAIN_SCRIPT=tools/chain_sablate.sh
SELF_TEARDOWN=0
CHAIN_EXTRA_ENV="SELF_TEARDOWN=0 AB_ARMS=SA256O GCS=gs://qhrrn2-arc/rescue/sablate_p2 GCS_SETS=gs://qhrrn2-arc/rescue/champ/sets LIVE_PREFIX=gs://qhrrn2-arc/rescue/sablate_p2/live AB_SRC=gs://qhrrn2-arc/rescue/wladder_p1"
WALL=30600
SENTINEL=CHAIN-SABLATE-COMPLETE
GCS=gs://qhrrn2-arc/rescue/sablate_p2
FINAL_OBJ=sablate_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
