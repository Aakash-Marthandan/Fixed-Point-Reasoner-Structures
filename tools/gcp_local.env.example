# TEMPLATE — copy to tools/.gcp_local.env (git-ignored) and fill in. The PI 2026-09-15: "git ignore the credential related
# details" — accounts, project ids and gcloud configuration names live ONLY in the local copy; every ops tool loads it through
# tools/gcp_local.sh and refuses to act (the watchdog: notifies BLIND) when it is missing.
QHRRN_GCP_ACCOUNT=you@example.com            # the GCP account both projects use
SUDOKU_PROJECT=your-sudoku-project           # the Sudoku era's own project (closed; its tools' default)
ARC_PROJECT=your-arc-project                 # the ARC era's project
ARC_GCLOUD_CONFIG=your-arc-gcloud-config     # a gcloud configuration pointing at ARC_PROJECT (not the active default)
SHARED_PROJECTS="your-arc-project"           # projects shared with others: our tools list, report and delete ONLY OWN_PREFIX resources there
SPOT_ONLY_PROJECTS="your-arc-project"        # projects where only spot TPUs may be created
OWN_PREFIX=qhrrn2-                           # every node of ours is named with this prefix
