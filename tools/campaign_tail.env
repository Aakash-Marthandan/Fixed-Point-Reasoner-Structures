# RUNG-1 TAIL campaign env (2026-08-26 pause) — copy over tools/campaign.env when
# resuming, then `DRY_SLEEP=150 nohup bash tools/pod.sh supervise 14 &`.
# THE LESSON OF 08-26: do NOT hand-roll hunts/launches — the proven supervisor +
# dispatcher detach path does hunt/bring-up/launch/watchdog/teardown correctly.
# CHAIN_SCRIPT here is the TAIL RUNBOOK (idempotent, GCS-guarded): it runs ONLY
# the missing PHASE4 work (s6+s14 of the pinned /16, the PHASE4-MID 20k scan,
# evaluator --merge, breadth20k packaging), then the UNMODIFIED chain_sportB.sh
# as a pure SKIP-cascade for completion guard + final tgz + sentinel + teardown.
# NEVER run chain_sportB.sh directly on a non-16 node while breadth20k.tgz is
# absent: its NSH partition would hollow-merge (b589334 class).
POD=qhrrn2-pod2
ZONES="us-east1-d us-east1-c us-east5-b us-central1-a us-central2-b us-west1-c us-west4-a asia-east1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8 v6e-4"
BIG_MAX_STRIKES=3
R_TAG=sportB
R_D=64
R_STEPS=50000
ARMS="B1 B2 B3 B4 B4s1 B5"
CHAIN_SCRIPT=tools/tail_runbook_sportB.sh
# SELF_POD/SELF_ZONE: verify v_launch exports them (chain self-teardown contract);
# if not, append SELF_POD=qhrrn2-pod2 SELF_ZONE=<landing zone> at launch.
CHAIN_EXTRA_ENV="ARMS_W0='B1' ARMS_W1='B2' ARMS_W2='B3' ARMS_W3='B4 B4s1 B5' PRIMARY='B1 B2 B3 B4' RD=64 WS=4 SCREEN_K=256 SX_NPZ=sudoku_extreme_seed0.npz SX_AUG=100 SX_T_STRAT='6 64 256' SX_K_INIT=16 SX_STRAT=512 SX_SUB=20000 SX_SUB_K=128 SX_RET_T=8 MON_EVERY=5000 GCS_W1=gs://qhrrn2-rescue/sport2 SELF_TEARDOWN=1"
WALL=30600
SENTINEL=CHAIN-SPORTB-COMPLETE
GCS=gs://qhrrn2-rescue/sportB
FINAL_OBJ=sportB_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
