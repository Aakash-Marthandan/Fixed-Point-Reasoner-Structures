# THE C8 EXTENSION env (2026-09-14; Documentation/Plan_2026-09-14_C8_Extension.md = the registration; the PI: "extend C8 ... to 50k steps
# ... check if we get a better optimal point than the current step"; "make sure not to delete or change previous results and data").
# ONE spot v6e-8 in Mumbai; the chain = tools/chain_c8x.sh (C8 resumed from its banked 30k state to 50k through chain_champ's extension
# path + the registered selection + the battery; the 10k held-out selection curves of C8/C5/C7; the filler rows for the monitor's pick;
# the extra test rows for the held-out pick and the PI's 46k). Everything is written under gs://qhrrn2-rescue/c8x; champ/ is read-only.
# Walls ~5.5-7 h (measured paces of this cell on the paper-final pod); cap launch + 13 h. SELF_TEARDOWN=0: the supervisor tears down on
# the final object / the sentinel.
POD=qhrrn2-pod2
ZONES="asia-south1-c"
ACCEL=v6e-8
ACCEL_LIST="v6e-8"
BIG_MAX_STRIKES=99
R_TAG=champ
R_D=192
R_STEPS=50000
ARMS="C8"
CHAIN_SCRIPT=tools/chain_c8x.sh
CHAIN_EXTRA_ENV="GCS=gs://qhrrn2-rescue/c8x LIVE_PREFIX=gs://qhrrn2-rescue/c8x/live"
SELF_TEARDOWN=0
WALL=46800
SENTINEL=CHAIN-C8X-COMPLETE
GCS=gs://qhrrn2-rescue/c8x
FINAL_OBJ=c8x_final.tgz
CANARY_CKPT=runs/pretrain6_d24/ckpt_latest.pkl
